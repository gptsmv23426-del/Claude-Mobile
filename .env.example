# Polymarket
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_polymarket_safe_address_here
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Bot Config
PAPER_TRADING=true
MAX_POSITION_SIZE_USDC=25
SCAN_INTERVAL_MINUTES=60
MIN_MARKET_VOLUME_USD=1000
MAX_SPREAD=0.08
MIN_EVIDENCE_QUALITY=0.55
MIN_EDGE_THRESHOLD=0.07
MAX_PORTFOLIO_EXPOSURE=0.20
MAX_DRAWDOWN_GATE=0.15
KELLY_FRACTION=0.25
MIN_BACKTEST_SHARPE=0.8

# ── Phase 2A: Cross-Reference Signals (Metaculus + Manifold) ──────────────────
# Zero new dependencies. Set to true to enable cross-referencing market questions
# against Metaculus and Manifold crowd forecasts before Claude makes its prediction.
ENABLE_CROSS_REFERENCE=false

# ── Phase 2B: FRED Macro Context ──────────────────────────────────────────────
# Requires: pip install fredapi
# Free API key at: https://fred.stlouisfed.org/docs/api/fred/
# Injects live macro indicators (Fed rate, CPI, unemployment, S&P500, 10Y yield)
# into the researcher prompt for MACRO category markets only.
FRED_API_KEY=
ENABLE_MACRO_CONTEXT=false

# ── Phase 2C: Local Polymarket Historical Data ────────────────────────────────
# Clone https://github.com/SII-WANGZJ/Polymarket_data to a local directory,
# then set this path. Backtester will use local files instead of the CLOB API,
# removing the 60-market cap and enabling thousand-market backtests.
POLYMARKET_DATA_PATH=

# ── Phase 3: Ensemble Forecasting ─────────────────────────────────────────────
# Runs 3 independent Haiku forecasts per market (base rate, bull, bear frames)
# and averages them. Costs ~3x Haiku tokens. Keep false until paper trading
# shows the single-call forecaster is well-calibrated (Brier < 0.20).
ENABLE_ENSEMBLE_FORECAST=false

# ── Phase 4: Trade Evaluation & Learning Loop ─────────────────────────────────
# Day of week for the weekly Claude Sonnet strategy review.
# Sonnet reads calibration metrics and outputs threshold adjustments.
# Valid values: monday, tuesday, wednesday, thursday, friday, saturday, sunday
WEEKLY_EVAL_DAY=monday
# Path where Sonnet's learned threshold recommendations are written.
# Config reads this file on startup and overrides defaults where present.
LEARNED_THRESHOLDS_PATH=logs/learned_thresholds.json
